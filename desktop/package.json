{
  "name": "xiaofeixia-desktop",
  "version": "1.0.0",
  "description": "小飞侠桌面客户端（Electron）",
  "main": "out/main/index.js",
  "author": "office-agent",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "dist": "electron-vite build && electron-builder --win nsis",
    "dist:dir": "electron-vite build && electron-builder --win --dir"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/adm-zip": "^0.5.8",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.7.3",
    "vite": "~7.3.6",
    "vue-tsc": "^3.3.9"
  },
  "dependencies": {
    "@langchain/anthropic": "^1.5.2",
    "@langchain/core": "^1.2.4",
    "@langchain/langgraph": "^1.4.8",
    "@langchain/mcp-adapters": "^1.1.3",
    "@langchain/openai": "^1.5.5",
    "adm-zip": "^0.6.0",
    "js-yaml": "^5.2.3",
    "lucide-vue-next": "^0.468.0",
    "markdown-it": "^14.3.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "zod": "^4.4.3"
  }
}
