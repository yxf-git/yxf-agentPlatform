# ===== 大模型配置 =====
# 后端会根据前端所选「模型名」自动路由到对应供应商，只需填对应的 Key 即可。

# DeepSeek（模型名 deepseek-chat / deepseek-reasoner）
DEEPSEEK_API_KEY=

# Kimi / Moonshot（模型名 moonshot-v1-8k / moonshot-v1-128k / kimi-k2-0711-preview 等）
MOONSHOT_API_KEY=

# 默认模型（前端未指定时使用）
MODEL_NAME=deepseek-chat

# 采样温度
TEMPERATURE=0.3

# ===== 通用兜底（可选）=====
# 当模型名既不属于 DeepSeek 也不属于 Kimi 时，使用下面这套任意 OpenAI 兼容接口
OPENAI_API_KEY=sk-none
OPENAI_BASE_URL=

# ===== 联网搜索（可选，用于 web_search 工具）=====
# 使用 Tavily：https://tavily.com  免费额度可用
TAVILY_API_KEY=

# ===== 服务配置 =====
HOST=127.0.0.1
PORT=8000

# 允许 exec_command 工具执行系统命令（把本机当服务器时开启）
ENABLE_EXEC=true

# 命令/代码执行超时（秒）
EXEC_TIMEOUT=60

# 前端开发服务器地址（用于 CORS）
FRONTEND_ORIGIN=http://localhost:5173
